{
  "name": "ntapi-desktop",
  "productName": "NTAPI",
  "version": "0.2.2",
  "description": "Desktop app for NTAPI (no terminal needed)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "author": "Chanathip Cheumklang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cheumklang/NTAPI.git"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.ntapi.desktop",
    "productName": "NTAPI",
    "icon": "build/icon.png",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cheumklang",
        "repo": "NTAPI-releases",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
