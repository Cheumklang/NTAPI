{
  "name": "ntapi-desktop",
  "productName": "NTAPI",
  "version": "0.3.5",
  "description": "Desktop app for NTAPI (no terminal needed)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-unit-tests.js",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "check:queue": "electron scripts/check-queue-placement.js",
    "check:reload": "electron scripts/check-reload-safety.js && electron scripts/check-reload-reattach-live.js",
    "check:history": "electron scripts/check-history-merge.js",
    "check:hold": "electron scripts/check-hold-before-send.js",
    "check:attach": "electron scripts/check-attachment-video.js"
  },
  "author": "Chanathip Cheumklang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cheumklang/NTAPI.git"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.ntapi.desktop",
    "productName": "NTAPI",
    "icon": "build/icon.png",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/quickjs-wasi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cheumklang",
        "repo": "NTAPI-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "electron-updater": "^6.8.11",
    "ws": "8.23.0"
  }
}
