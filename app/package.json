{
  "name": "ntapi-desktop",
  "productName": "NTAPI",
  "version": "0.5.9",
  "description": "รวม AI ที่มีโควตาฟรีไว้ในที่เดียว ลองก่อนจ่ายรายเดือน",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-unit-tests.js",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "check:queue": "electron scripts/check-queue-single-line.js",
    "check:reload": "electron scripts/check-reload-safety.js && electron scripts/check-reload-reattach-live.js",
    "check:history": "electron scripts/check-history-merge.js",
    "check:hold": "electron scripts/check-hold-before-send.js",
    "check:attach": "electron scripts/check-attachment-video.js",
    "check:read": "electron scripts/check-read-position.js",
    "check:cancel": "electron scripts/check-cancel-button.js",
    "check:queue-edit": "electron scripts/check-queue-edit.js",
    "check:approval": "electron scripts/check-approval-switch.js",
    "check:blocks": "electron scripts/check-turn-blocks.js",
    "check:queue-controls": "electron scripts/check-queue-controls.js",
    "check:queue-edit-hold": "electron scripts/check-queue-edit-hold.js",
    "check:queue-number": "electron scripts/check-queue-number.js",
    "check:marks": "electron scripts/check-session-marks.js",
    "check:author": "electron scripts/check-author-label.js",
    "check:narration": "electron scripts/check-narration-fold.js",
    "check:thinking": "electron scripts/check-thinking-switch.js",
    "check:strip": "electron scripts/check-status-strip.js",
    "check:ghost": "electron scripts/check-queue-ghost.js",
    "check:chips": "electron scripts/check-activity-chips.js",
    "check:notice": "electron scripts/check-notice-bubble.js",
    "check:pill": "electron scripts/check-status-pill.js",
    "check:sidebar": "electron scripts/check-sidebar-reset.js",
    "check:media": "electron scripts/check-sponsor-media.js",
    "check:guide": "electron scripts/check-first-run-guide.js",
    "check:undo": "electron scripts/check-undo-send.js",
    "check:restore": "electron scripts/check-restore-active-tab.js",
    "check:busy": "electron scripts/check-busy-state.js",
    "check:transcript": "electron scripts/check-transcript-resilience.js",
    "check:speed": "electron scripts/check-transcript-speed.js",
    "bench:transcript": "electron scripts/bench-transcript.js"
  },
  "author": "Chanathip Cheumklang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cheumklang/NTAPI.git"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.ntapi.desktop",
    "productName": "NTAPI",
    "icon": "build/icon.png",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/quickjs-wasi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cheumklang",
        "repo": "NTAPI-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "electron-updater": "^6.8.11",
    "ws": "8.23.0"
  }
}
