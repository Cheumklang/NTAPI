{
  "name": "ntapi-desktop",
  "productName": "NTAPI",
  "version": "0.7.3",
  "description": "รวม AI ที่มีโควตาฟรีไว้ในที่เดียว ลองก่อนจ่ายรายเดือน",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-unit-tests.js",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "check:queue": "electron --no-sandbox scripts/check-queue-single-line.js",
    "check:reload": "electron --no-sandbox scripts/check-reload-safety.js && electron scripts/check-reload-reattach-live.js",
    "check:history": "electron --no-sandbox scripts/check-history-merge.js",
    "check:hold": "electron --no-sandbox scripts/check-hold-before-send.js",
    "check:attach": "electron --no-sandbox scripts/check-attachment-video.js",
    "check:read": "electron --no-sandbox scripts/check-read-position.js",
    "check:cancel": "electron --no-sandbox scripts/check-cancel-button.js",
    "check:queue-edit": "electron --no-sandbox scripts/check-queue-edit.js",
    "check:approval": "electron --no-sandbox scripts/check-approval-switch.js",
    "check:blocks": "electron --no-sandbox scripts/check-turn-blocks.js",
    "check:queue-controls": "electron --no-sandbox scripts/check-queue-controls.js",
    "check:queue-edit-hold": "electron --no-sandbox scripts/check-queue-edit-hold.js",
    "check:queue-number": "electron --no-sandbox scripts/check-queue-number.js",
    "check:marks": "electron --no-sandbox scripts/check-session-marks.js",
    "check:author": "electron --no-sandbox scripts/check-author-label.js",
    "check:narration": "electron --no-sandbox scripts/check-narration-fold.js",
    "check:thinking": "electron --no-sandbox scripts/check-thinking-switch.js",
    "check:strip": "electron --no-sandbox scripts/check-status-strip.js",
    "check:ghost": "electron --no-sandbox scripts/check-queue-ghost.js",
    "check:chips": "electron --no-sandbox scripts/check-activity-chips.js",
    "check:scroll": "electron --no-sandbox scripts/check-scroll-to-latest.js",
    "check:fold": "electron --no-sandbox scripts/check-model-fold.js",
    "check:stale-queue": "electron --no-sandbox scripts/check-stale-queue.js",
    "check:queue-hold": "electron --no-sandbox scripts/check-queue-hold.js",
    "prove:verify": "node scripts/provenance.js verify",
    "notices": "node scripts/gen-notices.js",
    "notices:check": "node scripts/gen-notices.js --check",
    "check:order": "electron --no-sandbox scripts/check-message-order.js",
    "check:buy": "electron --no-sandbox scripts/check-provider-buy-links.js",
    "check:legal": "electron --no-sandbox scripts/check-legal-docs.js",
    "check:tools": "electron --no-sandbox scripts/check-tool-lifecycle.js",
    "check:undo-shortcut": "electron --no-sandbox scripts/check-undo-shortcut.js",
    "check:turn-status": "electron --no-sandbox scripts/check-turn-status.js",
    "check:notice": "electron --no-sandbox scripts/check-notice-bubble.js",
    "check:pill": "electron --no-sandbox scripts/check-status-pill.js",
    "check:sidebar": "electron --no-sandbox scripts/check-sidebar-reset.js",
    "check:media": "electron --no-sandbox scripts/check-sponsor-media.js",
    "check:guide": "electron --no-sandbox scripts/check-first-run-guide.js",
    "check:undo": "electron --no-sandbox scripts/check-undo-send.js",
    "check:restore": "electron --no-sandbox scripts/check-restore-active-tab.js",
    "check:busy": "electron --no-sandbox scripts/check-busy-state.js",
    "check:transcript": "electron --no-sandbox scripts/check-transcript-resilience.js",
    "check:speed": "electron --no-sandbox scripts/check-transcript-speed.js",
    "bench:transcript": "electron --no-sandbox scripts/bench-transcript.js",
    "check:shell": "electron --no-sandbox scripts/check-shell-usable.js",
    "check:lost": "electron --no-sandbox scripts/repro-message-loss.js",
    "check:tooluse": "electron --no-sandbox scripts/check-provider-tooluse.js",
    "check:liveturn": "electron --no-sandbox scripts/check-live-turn-bubble.js",
    "check:sara": "node scripts/check-sara-am.js",
    "check:skills": "node scripts/selftest-skill-menu.js && node scripts/selftest-skill-notes.js"
  },
  "author": "Chanathip Cheumklang",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cheumklang/NTAPI.git"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.ntapi.desktop",
    "productName": "NTAPI",
    "icon": "build/icon.png",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/quickjs-wasi/**",
      "src/system/atspi.py",
      "src/system/uia.ps1"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": "store-asar",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cheumklang",
        "repo": "NTAPI-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../TERMS.md",
        "to": "TERMS.md"
      },
      {
        "from": "../PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "../SECURITY.md",
        "to": "SECURITY.md"
      }
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "electron-updater": "^6.8.11",
    "ws": "8.23.0"
  }
}
